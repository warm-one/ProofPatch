{
  "name": "proofpatch",
  "private": true,
  "version": "0.2.0",
  "description": "独立执行证据层：证明一个补丁真的修复了失败，而不只是看起来像修好了",
  "type": "module",
  "bin": {
    "proofpatch": "bin/proofpatch.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "!server/**/*.test.mjs",
    "!server/verifier/testPython.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --no-cache --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest --no-cache",
    "verify": "node bin/proofpatch.mjs verify",
    "check": "node bin/proofpatch.mjs check",
    "verify:receipt": "node bin/proofpatch.mjs verify-receipt",
    "acceptance": "node scripts/acceptance-matrix.mjs",
    "fixture:patches": "node scripts/build-fixture-patches.mjs",
    "fixture:repo": "node scripts/init-fixture-repo.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
